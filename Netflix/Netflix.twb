      <aliases enabled='yes' />
      <column caption='Total Titles' datatype='integer' name='[Calculation_0813663820603392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([show_id])' />
      </column>
      <column caption='Total Movies' datatype='integer' name='[Calculation_0813663821496321]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [type] = &quot;Movie&quot; THEN [show_id] END&#13;&#10;)' />
      </column>
      <column caption='Total TV Shows' datatype='integer' name='[Calculation_0813663821905922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [type] = &quot;TV Show&quot; THEN [show_id] END&#13;&#10;)' />
      </column>
      <column caption='Titles Added per Year' datatype='integer' name='[Calculation_0813663823376387]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([show_id])' />
      </column>
      <column caption='Latest Content' datatype='integer' name='[Calculation_0813663824121860]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([release_year])' />
      </column>
      <column caption='Avg Movie Duration' datatype='real' name='[Calculation_0813663825494023]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#13;&#10;IF [type] = &quot;Movie&quot; THEN INT([duration_minutes]) END&#13;&#10;)' />
      </column>
      <column caption='Average Seasons' datatype='integer' name='[Calculation_0813663828287498]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF CONTAINS([duration_seasons], &quot;Season&quot;) THEN&#13;&#10;INT(REGEXP_EXTRACT([duration_seasons], &quot;[0-9]+&quot;))&#13;&#10;END' />
      </column>
      <column caption='Titles by Country' datatype='integer' name='[Calculation_0813663829553163]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([show_id])' />
      </column>
      <column caption='Titles by Genre' datatype='integer' name='[Calculation_0813663829827596]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([show_id])' />
      </column>
      <column caption='Rating ' datatype='integer' name='[Calculation_0813663895719950]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([rating])' />
      </column>
      <column caption='netflix_titles_cast' datatype='table' name='[__tableau_internal_object_id__].[netflix!titles!cast_59CF6638E17D4103A2EAC428A97EE77B]' role='measure' type='quantitative' />
